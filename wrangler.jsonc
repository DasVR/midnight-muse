// Cloudflare Workers static assets: serves the site in ./wireframe as-is.
// Deploy with `npx wrangler deploy`, or connect the GitHub repo in the
// Cloudflare dashboard (Workers & Pages → Create → Import a repository) so
// every push to main deploys. See docs/HOSTING.md.
{
  "name": "midnight-muse",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./wireframe"
  }
}
